# ============================================================================
# split.yaml — eBPF-Split 框架配置（语法：极简 YAML 子集，见 docs/04-CONFIG.md）
# 只支持：section: / key: value / - list item / # 注释
# ============================================================================

debug: false            # true 时不 daemon 化，并输出 debug 日志

# ---- 代理内核对接（把该设备的 ifindex 写进 map_tun）----
tun_device: utun            # mihomo tun.device（configs/mihomo/*.yaml 里一致）

# ---- 挂载范围 ----
ifaces:
  attach_auto: true        # true=自动发现物理网卡并全挂
  attach_list:             # attach_auto=false 时才用
    - wlan0
    - rmnet_data0
  exclude:                 # 前缀匹配排除
    - lo
    - tun
    - tap
    - dummy

# ---- 未命中时的默认行为 ----
default:
  verdict: tun            # tun(代理) | direct(直连)；海外默认代理
  ipv6: true              # 参与 IPv6 分类

# ---- 强制规则段（优先级高于 CNIP）----
rules:
  # 强制代理：fake-ip 池（对齐 mihomo fake-ip-range / fake-ip-range6）
  proxy_cidr4:
    - 198.18.0.0/15
  proxy_cidr6:
    - fdfe:dcba:9876::/64

  # 强制直连（内网/自有网段等；内置已含 rfc1918/链路本地/回环）
  # direct_cidr4:
  #   - 10.0.0.0/8
  # direct_cidr6:
  #   - fc00::/7

  # UID 白名单（直连，跳过判定）——mihomo 自身的 uid 必须放这，防止回环！
  # root=0 shell=2000；mihomo 若是普通 apk，用其 appId（如 10101）
  skip_uid:
    - 0
    - 2000

# ---- CNIP 数据源（二选一即可；都留空则纯规则分流）----
# 注意：建议用绝对路径（避免 splitd 工作目录歧义）。
# Android 上可直接复用 box 模块的 cn.zone：cp /data/adb/box/run/cn.zone config/cn_cidr_v4.txt
cnip:
  path_v4: /data/adb/split/config/cn_cidr_v4.txt
  path_v6: /data/adb/split/config/cn_cidr_v6.txt
  # 自动更新：daemon 每 auto_update_hours 用下载器下载 url_v4/v6 覆盖到 path_v4/v6 后重灌 map。
  # url 留空 = 只按间隔重读本地文件（不会联网）。0=关闭自动更新。
  # 多源 fallback（v1.4.2）：url 支持逗号分隔多个候选，按序尝试、任一成功即用。
  #   jsDelivr 大陆可达优先，raw.githubusercontent 全球更稳兜底。
  # v4 源 misakaio/chnroutes2（每日 APNIC 聚合）；v6 源 gaoyifan/china-operator-ip（每日）。
  url_v4: https://cdn.jsdelivr.net/gh/misakaio/chnroutes2@master/chnroutes.txt,https://raw.githubusercontent.com/misakaio/chnroutes2/master/chnroutes.txt
  url_v6: https://cdn.jsdelivr.net/gh/gaoyifan/china-operator-ip@ip-lists/china6.txt,https://raw.githubusercontent.com/gaoyifan/china-operator-ip/ip-lists/china6.txt
  auto_update_hours: 24   # 1 天